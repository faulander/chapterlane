# Copy to .env for local development (bun run dev).
# For Docker, create a small .env as described in the README instead of copying this file.

DATABASE_PATH=data/chapterlane.db
LOG_LEVEL=debug

# Optional. Book search and cover lookups work without a key but are rate limited.
GOOGLE_BOOKS_API_KEY=

# --- Docker Compose (docker-compose.yml reads these from .env) ---
# Exactly the address you type in the browser, no trailing slash. Logins fail if it differs.
# APP_ORIGIN=http://localhost:3002
# CHAPTERLANE_PORT=3002
# Set to true when the site is served over https.
# COOKIE_SECURE=false
# Folder of your Calibre library, only needed for Calibre import.
# CALIBRE_LIBRARY_PATH=/path/to/your/calibre/library
